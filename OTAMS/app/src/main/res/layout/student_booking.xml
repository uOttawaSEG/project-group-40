<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80746C"
    tools:context=".StudentProfile">

    <TextView
        android:id="@+id/end_time_text"
        android:layout_width="159dp"
        android:layout_height="28dp"
        android:layout_marginTop="76dp"
        android:gravity="center"
        android:text="End Time"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/start_time" />

    <EditText
        android:id="@+id/end_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="time"
        android:padding="10dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_back3"
        app:layout_constraintTop_toBottomOf="@+id/end_time_text"
        app:layout_constraintVertical_bias="0.168"
        tools:layout_editor_absoluteX="100dp" />

    <TextView
        android:id="@+id/Header3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#8F001A"
        android:padding="20dp"
        android:text="Booking Session"
        android:textAlignment="center"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_home3"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#E8E8E8"
        android:text="🏠"
        android:textColor="@color/UOgray"
        android:textColorHighlight="@color/UOgray"
        android:textColorHint="@color/UOgray"
        android:textColorLink="@color/UOgray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_back3"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@color/UOred" />

    <Button
        android:id="@+id/btn_back3"
        android:layout_width="105dp"
        android:layout_height="70dp"
        android:layout_marginEnd="100dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#8F001A"
        android:text="Back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_home3"/>

    <Button
        android:id="@+id/request_button"
        android:layout_width="280dp"
        android:layout_height="83dp"
        android:backgroundTint="#8F001A"
        android:text="Request"
        app:layout_constraintBottom_toTopOf="@+id/btn_back3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/end_time"
        app:layout_constraintVertical_bias="0.464" />

    <TextView
        android:id="@+id/start_time_text"
        android:layout_width="159dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Start Time"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info_text_session_booking" />

    <EditText
        android:id="@+id/start_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ems="10"
        android:inputType="time"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@+id/start_time_text"
        tools:layout_editor_absoluteX="100dp" />

    <TextView
        android:id="@+id/info_text_session_booking"
        android:layout_width="228dp"
        android:layout_height="76dp"
        android:layout_marginTop="28dp"
        android:text="TextView"
        app:layout_constraintTop_toBottomOf="@+id/Header3"
        tools:layout_editor_absoluteX="91dp" />;

</androidx.constraintlayout.widget.ConstraintLayout>